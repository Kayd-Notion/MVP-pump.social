# ===========================================================================
# pump.social — backend stack (docker-compose.yml)
#
#   Copy to .env (git-ignored) and fill the values marked CHANGE ME:
#     PowerShell:  Copy-Item .env.example .env
#
# The frontend has its own file: .env.local.example → .env.local
# ===========================================================================

# --- Postgres ---------------------------------------------------------------
POSTGRES_DB=pump
POSTGRES_USER=pump
# CHANGE ME. Any characters are fine (passed to the API as PGPASSWORD, not in a URL).
POSTGRES_PASSWORD=change-me-postgres-password

# --- MinIO (S3-compatible media storage) -----------------------------------
# Root credentials, also used by the API to access the bucket.
MINIO_ROOT_USER=pumpadmin
# CHANGE ME (MinIO requires at least 8 characters).
MINIO_ROOT_PASSWORD=change-me-minio-password
# Bucket for post media (created automatically by the API at startup).
S3_BUCKET=pump-media
# Base URL browsers use to reach MinIO (media upload + public media URLs).
# Locally: http://localhost:9000. On the VPS: https://media.<your-domain>.
S3_PUBLIC_URL=http://localhost:9000
# Max upload size in bytes (default 25 MB).
MEDIA_MAX_BYTES=26214400
# Image used for the MinIO service (see README about MinIO distribution).
# MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z

# --- API: auth ---------------------------------------------------------------
# CHANGE ME: at least 32 random characters. PowerShell (Windows 10):
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# JWT lifetime (seconds). Default 7 days.
JWT_TTL_SECONDS=604800
# Sign-in challenge (nonce) lifetime, seconds.
NONCE_TTL_SECONDS=300
# Name shown in the message the wallet signs.
AUTH_DOMAIN=pump.social
# Allowed browser origins (comma-separated). The Next.js dev server by default.
CORS_ORIGINS=http://localhost:3000

# --- API: Solana ---------------------------------------------------------------
# SECURITY: stays on devnet. The API refuses to start on mainnet-beta unless
# ALLOW_MAINNET=true (only once the on-chain program is audited).
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Wallet receiving the platform share (30%) of every pump. CHANGE ME to a
# devnet wallet you control. The frontend reads it from GET /config, so it only
# needs to be set here.
PLATFORM_WALLET=4QmGx5cAVfuSdEpZgwmwv6J5SJbWYguphDAv8a6Jn22r
# Creator share in basis points (7000 = 70% creator / 30% platform).
PUMP_CREATOR_BPS=7000
# A pump transaction older than this (seconds) is refused.
PUMP_MAX_TX_AGE_SECONDS=900
# Minimum pump in SOL (refused below, in the UI and by the API). 0.005 keeps
# both shares above Solana's rent-exempt minimum for an empty recipient wallet.
# The frontend reads this value from the API (GET /config).
MIN_PUMP_SOL=0.005
# Pumping an EXPIRED post must give it at least this much life (seconds),
# otherwise the post would be purged right after being "saved".
PUMP_SAVE_MIN_LIFETIME_SECONDS=3600
# Reservation made right before signing a pump: the purge job won't delete the
# post while it is active (must exceed a transaction's ~1-2 min validity).
PUMP_INTENT_TTL_SECONDS=180

# --- API: expiry / purge -------------------------------------------------------
# How often the expiry job runs (seconds).
PURGE_INTERVAL_SECONDS=300
# Expired posts in the top N of the all-time posts leaderboard are kept forever.
KEEP_TOP_N=100

# --- API: geolocation ------------------------------------------------------------
# Locally every request comes from a private Docker IP, which has no country.
# This value is used for private IPs only, so the "par pays" views can be tested.
# Leave EMPTY on the VPS.
DEV_DEFAULT_COUNTRY=FR

# --- Host ports (all bound to 127.0.0.1) -------------------------------------
API_HOST_PORT=4000
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
POSTGRES_HOST_PORT=5432

# --- Behind a reverse proxy (VPS) ------------------------------------------------
# Set to true once Caddy/nginx sits in front of the API (real client IPs).
TRUST_PROXY=false
